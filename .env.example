PORT=3000

# --- Admin session (set strong, unique values before deployment) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# --- Public vs admin links ---
# Leave ADMIN_HOST empty for one address: public at "/", admin at "/admin".
# For a separate admin domain, point it at this same app and set e.g.:
#   ADMIN_HOST=admin.example.com
#   PUBLIC_URL=https://www.example.com
ADMIN_HOST=
PUBLIC_URL=

# --- AI card extraction (open-source vision model) ---
# Live site: free Groq key from https://console.groq.com/keys (photos go to Groq).
# When GROQ_API_KEY is set, Groq is used; otherwise local Ollama.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# AI_PROVIDER=groq   (or ollama) to force one
# Local PC: install Ollama from https://ollama.com, then: ollama pull qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3.5:4b

# --- n8n workflows ---
# Use the production webhook URLs from your n8n instance.
N8N_REGISTRATION_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_URL=
N8N_THANK_YOU_WEBHOOK_URL=
N8N_INBOUND_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=replace-with-a-shared-random-secret

# --- WhatsApp Cloud API (Meta) ---
# From developers.facebook.com > your app > WhatsApp > API Setup
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Instagram Messaging (Meta Graph API) ---
INSTAGRAM_VERIFY_TOKEN=choose-any-secret-string
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
